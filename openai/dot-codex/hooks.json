{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os, runpy; runpy.run_path(os.path.expanduser('~/.codex/hooks/user_prompt_secret_guard.py'), run_name='__main__')\"",
            "timeout": 10,
            "statusMessage": "Checking prompt for secrets"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os, runpy; runpy.run_path(os.path.expanduser('~/.codex/hooks/permission_request_guard.py'), run_name='__main__')\"",
            "timeout": 10,
            "statusMessage": "Checking approval request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os, runpy; runpy.run_path(os.path.expanduser('~/.codex/hooks/stop_validation_nudge.py'), run_name='__main__')\"",
            "timeout": 10,
            "statusMessage": "Checking validation closeout"
          }
        ]
      }
    ]
  }
}
