{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/evals/eval-case.schema.json",
  "title": "Codex Eval Case File",
  "type": "object",
  "required": [
    "schema_version",
    "workflow",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "workflow": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "mode",
          "trigger_expectation",
          "goal",
          "setup",
          "prompt",
          "expected_output_shape",
          "expected_safety_behavior",
          "expected_validation_behavior",
          "pass_criteria",
          "fail_signals"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "skill",
              "subagent"
            ]
          },
          "trigger_expectation": {
            "type": "string",
            "enum": [
              "should_trigger",
              "should_not_trigger"
            ]
          },
          "goal": {
            "type": "string"
          },
          "why_this_tier": {
            "type": "string"
          },
          "workflows_under_test": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "setup": {
            "type": "string"
          },
          "fixture_ref": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "expected_subagents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_subagents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_output_shape": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected_safety_behavior": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected_validation_behavior": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "pass_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "fail_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
